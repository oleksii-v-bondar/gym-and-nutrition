# Co-hosting env for the gym app. Copy to cohost/.env and fill in secrets.
# cohost/.env is git-ignored.
POSTGRES_USER=gym
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=gym
JWT_SECRET=change-me-long-random
ADMIN_LOGIN=ascererak
# Plain HTTP inside the container; the host nginx terminates TLS.
SITE_ADDRESS=:80
